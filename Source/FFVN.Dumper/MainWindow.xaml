<Window x:Class="FfvnDumper.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="FFVN Dumper — Free Fire VN IL2CPP Dumper (© 2026 quangbaong)"
 Width="880" Height="680" MinWidth="740" MinHeight="560"
 WindowStartupLocation="CenterScreen" Background="#0B0F17" Foreground="#E2E8F0"
 FontFamily="Segoe UI" AllowDrop="True" DragOver="Window_DragOver" DragLeave="Window_DragLeave" Drop="Window_Drop">
 <Window.Resources>
  <Style x:Key="ModernTextBox" TargetType="TextBox">
   <Setter Property="Background" Value="#090D14"/>
   <Setter Property="Foreground" Value="#F1F5F9"/>
   <Setter Property="CaretBrush" Value="#F97316"/>
   <Setter Property="BorderBrush" Value="#263143"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="10,7"/>
   <Setter Property="Height" Value="36"/>
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="TextBox">
      <Border x:Name="Bd" Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="7" SnapsToDevicePixels="True">
       <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter TargetName="Bd" Property="BorderBrush" Value="#F97316"/>
       </Trigger>
       <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <Style x:Key="SecondaryButton" TargetType="Button">
   <Setter Property="Background" Value="#1B2434"/>
   <Setter Property="Foreground" Value="#E2E8F0"/>
   <Setter Property="BorderBrush" Value="#2D3A4F"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Height" Value="36"/>
   <Setter Property="Padding" Value="14,0"/>
   <Setter Property="FontSize" Value="12.5"/>
   <Setter Property="FontWeight" Value="Medium"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Bd" Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="7" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Bd" Property="Background" Value="#263348"/>
        <Setter TargetName="Bd" Property="BorderBrush" Value="#475569"/>
       </Trigger>
       <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Bd" Property="Background" Value="#141B27"/>
       </Trigger>
       <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <Style x:Key="PrimaryButton" TargetType="Button">
   <Setter Property="Background" Value="#EA580C"/>
   <Setter Property="Foreground" Value="#FFFFFF"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Height" Value="36"/>
   <Setter Property="Padding" Value="18,0"/>
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Bd" Background="{TemplateBinding Background}"
              CornerRadius="7" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Bd" Property="Background" Value="#F97316"/>
       </Trigger>
       <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Bd" Property="Background" Value="#C2410C"/>
       </Trigger>
       <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Bd" Property="Background" Value="#7C2D12"/>
        <Setter Property="Foreground" Value="#CBD5E1"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>

 <Grid Margin="20">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <!-- Header & Copyright Card -->
  <Border Grid.Row="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,12">
   <Grid>
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="*"/>
     <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0" VerticalAlignment="Center">
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock Text="FFVN Dumper" FontSize="22" FontWeight="Bold" Foreground="#F8FAFC"/>
      <Border Background="#2A160B" BorderBrush="#9A3412" BorderThickness="1" CornerRadius="5" Padding="8,2" Margin="10,2,0,0" VerticalAlignment="Center">
       <TextBlock Text="IL2CPP v31 · .rodata AES+XOR+16K" FontSize="11" FontWeight="SemiBold" Foreground="#FB923C"/>
      </Border>
     </StackPanel>
     <TextBlock Text="Trích xuất APK / XAPK Free Fire VN → Giải mã .rodata &amp; khôi phục cấu trúc DummyDll / dump.cs / script.json"
                FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0"/>
    </StackPanel>

    <!-- Copyright & Author Badge -->
    <Border Grid.Column="1" Background="#0D1422" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="12,7" VerticalAlignment="Center">
     <StackPanel HorizontalAlignment="Right">
      <TextBlock HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="#FBBF24" Text="© 2026 quangbaong (BANNEI)"/>
      <TextBlock HorizontalAlignment="Right" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0">
       <Run Text="v1.0.0 · "/>
       <Hyperlink NavigateUri="https://github.com/quangbaong" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#60A5FA" TextDecorations="None">
        <Run Text="github.com/quangbaong"/>
       </Hyperlink>
      </TextBlock>
     </StackPanel>
    </Border>
   </Grid>
  </Border>

  <!-- Target Package & Output Card -->
  <Border x:Name="DropCard" Grid.Row="1" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,12">
   <Grid>
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="125"/>
     <ColumnDefinition Width="*"/>
     <ColumnDefinition Width="138"/>
    </Grid.ColumnDefinitions>

    <TextBlock Grid.Row="0" Grid.Column="0" Text="Gói game:" VerticalAlignment="Center" Foreground="#CBD5E1" FontSize="13" FontWeight="Medium"/>
    <TextBox x:Name="PackageTextBox" Grid.Row="0" Grid.Column="1" Style="{StaticResource ModernTextBox}"/>
    <Button x:Name="BrowsePackageButton" Grid.Row="0" Grid.Column="2" Content="Chọn APK / XAPK" Margin="10,0,0,0" Style="{StaticResource SecondaryButton}" Click="BrowsePackage_Click"/>

    <TextBlock Grid.Row="1" Grid.Column="0" Text="Thư mục lưu:" VerticalAlignment="Center" Foreground="#CBD5E1" FontSize="13" FontWeight="Medium" Margin="0,10,0,0"/>
    <TextBox x:Name="OutputTextBox" Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" Style="{StaticResource ModernTextBox}"/>
    <Button x:Name="BrowseOutputButton" Grid.Row="1" Grid.Column="2" Content="Chọn thư mục" Margin="10,10,0,0" Style="{StaticResource SecondaryButton}" Click="BrowseOutput_Click"/>

    <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,7,0,0" FontSize="11.5" Foreground="#64748B"
               Text="Mẹo: Kéo thả file .xapk / .apks / .apk / .zip trực tiếp vào cửa sổ để chọn nhanh."/>
   </Grid>
  </Border>

  <!-- Action Bar & Telemetry -->
  <Border Grid.Row="2" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,12">
   <Grid>
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid Grid.Row="0">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
     </Grid.ColumnDefinitions>
     <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
      <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#64748B" Margin="0,0,8,0" VerticalAlignment="Center"/>
      <TextBlock x:Name="StatusText" Text="Sẵn sàng." VerticalAlignment="Center" Foreground="#E2E8F0" FontSize="13" FontWeight="Medium"/>
     </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal">
      <Button x:Name="ClearLogButton" Content="Xóa log" Style="{StaticResource SecondaryButton}" Click="ClearLog_Click" Margin="0,0,8,0"/>
      <Button x:Name="OpenOutputButton" Content="Mở kết quả" Style="{StaticResource SecondaryButton}" Click="OpenOutput_Click" Margin="0,0,8,0"/>
      <Button x:Name="StartButton" Content="Bắt đầu dump" Style="{StaticResource PrimaryButton}" Click="Start_Click"/>
     </StackPanel>
    </Grid>

    <Grid Grid.Row="1" Margin="0,10,0,0">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
     </Grid.ColumnDefinitions>
     <Border Background="#1E293B" CornerRadius="4" Height="7" ClipToBounds="True" VerticalAlignment="Center">
      <ProgressBar x:Name="ProgressBar" Height="7" Background="Transparent" Foreground="#F97316" BorderThickness="0">
       <ProgressBar.Template>
        <ControlTemplate TargetType="ProgressBar">
         <Grid x:Name="PART_Track">
          <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
          <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="4"/>
         </Grid>
        </ControlTemplate>
       </ProgressBar.Template>
      </ProgressBar>
     </Border>
     <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
      <Border x:Name="ChipAbi" Background="#0D1422" BorderBrush="#263143" BorderThickness="1" CornerRadius="5" Padding="8,2" Margin="0,0,6,0" Visibility="Collapsed">
       <TextBlock x:Name="ChipAbiText" FontSize="11" Foreground="#93C5FD"/>
      </Border>
      <Border x:Name="ChipCrypto" Background="#0D1422" BorderBrush="#263143" BorderThickness="1" CornerRadius="5" Padding="8,2" Margin="0,0,6,0" Visibility="Collapsed">
       <TextBlock x:Name="ChipCryptoText" FontSize="11" Foreground="#FCD34D"/>
      </Border>
      <Border x:Name="ChipStats" Background="#0D1422" BorderBrush="#263143" BorderThickness="1" CornerRadius="5" Padding="8,2" Visibility="Collapsed">
       <TextBlock x:Name="ChipStatsText" FontSize="11" Foreground="#6EE7B7"/>
      </Border>
     </StackPanel>
    </Grid>
   </Grid>
  </Border>

  <!-- Log Output Card -->
  <Border Grid.Row="3" Background="#090D14" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="10" Padding="12,10">
   <Grid>
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="2,0,2,6">
     <TextBlock Text="NHẬT KÝ XỬ LÝ" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
     <TextBlock x:Name="TimerText" Text="" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
    </DockPanel>
    <TextBox x:Name="LogTextBox" Grid.Row="1" IsReadOnly="True" TextWrapping="NoWrap"
             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AcceptsReturn="True"
             Background="Transparent" Foreground="#CBD5E1" BorderThickness="0"
             FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
   </Grid>
  </Border>

  <!-- Copyright Footer Bar -->
  <Grid Grid.Row="4" Margin="2,10,2,0">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="Auto"/>
   </Grid.ColumnDefinitions>
   <TextBlock Grid.Column="0" FontSize="11.5" Foreground="#94A3B8" VerticalAlignment="Center">
    <Run Text="© 2026 quangbaong (BANNEI) — FFVN Dumper · "/>
    <Hyperlink NavigateUri="https://github.com/quangbaong" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#60A5FA" TextDecorations="None">
     <Run Text="https://github.com/quangbaong"/>
    </Hyperlink>
   </TextBlock>
   <TextBlock Grid.Column="1" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center"
              Text="Core: Il2CppDumper (Perfare / AndnixSH) · Unity IL2CPP ARM"/>
  </Grid>
 </Grid>
</Window>
